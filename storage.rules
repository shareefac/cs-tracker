rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // EDIT: same emails as firestore.rules
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['uvais@example.com', 'shareef@example.com'];
    }
    match /tracker/{trackerId}/{file} {
      allow read: if allowed();
      allow delete: if allowed();
      allow create, update: if allowed() && request.resource.size < 20 * 1024 * 1024;
    }
  }
}
