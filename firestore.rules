rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // EDIT: lower-case emails allowed to use the tracker
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['muhammedshareefclt@gmail.com'];
    }
    match /tracker/{trackerId}/{collection}/{docId} {
      allow read, write: if allowed();
    }
  }
}
